<Application x:Class="Bkdict.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- BKDG type: IBM Plex Sans for body, Zilla Slab for titles, IBM Plex Mono for labels.
             The .ttf files are linked from Resources/Fonts (see Bkdict.csproj). -->
        <FontFamily x:Key="BodyFont">pack://application:,,,/Fonts/#IBM Plex Sans</FontFamily>
        <FontFamily x:Key="DisplayFont">pack://application:,,,/Fonts/#Zilla Slab</FontFamily>
        <FontFamily x:Key="MonoFont">pack://application:,,,/Fonts/#IBM Plex Mono</FontFamily>
        <!-- The Fluent theme reads this key for every control's text. -->
        <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/Fonts/#IBM Plex Sans</FontFamily>

        <!-- BKDG corners: 4px at most (D-03). Overrides the Fluent theme's 4/8. -->
        <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">4</CornerRadius>

        <!-- Colors (Brand*, plus the Fluent keys they replace) are set per theme by UI/Brand.cs. -->

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource BrandText}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,28,0,10" />
        </Style>
        <Style x:Key="Subtle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrandSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrandError}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <!-- Filled Bordô button for the main action of a row (e.g. "Conectar com o Google"). -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BrandOnAccent}" />
            <Setter Property="Background" Value="{DynamicResource BrandAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="{DynamicResource BrandCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBorder}" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="{DynamicResource BrandCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBorder}" />
        </Style>
        <!-- Uppercase mono label (write the text in caps; WPF has no letter-spacing). -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource BrandTertiary}" />
        </Style>
    </Application.Resources>
</Application>
