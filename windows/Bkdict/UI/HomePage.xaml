<UserControl x:Class="Bkdict.UI.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A row's icon button: a framed square that lights up under the pointer. -->
        <Style x:Key="RowAction" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource BrandSecondary}" />
            <Setter Property="Background" Value="{DynamicResource BrandCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBorder}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="Light" Background="{DynamicResource BrandHover}" CornerRadius="4" Visibility="Collapsed" />
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Light" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource BrandText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Delete lights up in Bordô. -->
        <Style x:Key="RowActionDestructive" TargetType="Button" BasedOn="{StaticResource RowAction}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrandAccent}" />
                    <Setter Property="Background" Value="{DynamicResource BrandAccentTint}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BrandAccent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Início" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource Subtle}"
                   Text="Em qualquer app: o Bkdict transcreve, ajusta a pontuação e insere o texto na posição do cursor." />

        <Border Style="{StaticResource Card}" Margin="0,20,0,8" Padding="20,16" BorderThickness="0"
                Background="{DynamicResource BrandAccentSurface}">
            <StackPanel>
                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Medium"
                           Foreground="{DynamicResource BrandOnAccent}">
                    <Run Text="Segure " /><Run Text="{Binding DictateLabel, Mode=OneWay}" FontStyle="Italic" /><Run Text=" e fale" />
                </TextBlock>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Subtle}" Margin="0,4,0,0"
                           Foreground="{DynamicResource BrandOnAccent}" Opacity="0.8" />
            </StackPanel>
        </Border>

        <UniformGrid Columns="3">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding TotalWords}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="palavras ditadas" Style="{StaticResource Subtle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="{Binding StreakDays}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="dias seguidos" Style="{StaticResource Subtle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding WordsPerMinute}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="palavras por minuto" Style="{StaticResource Subtle}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <DockPanel Margin="0,28,0,10">
            <Button DockPanel.Dock="Right" Content="Limpar histórico" Click="Clear_Click" />
            <TextBox x:Name="Search" DockPanel.Dock="Right" Width="220" Margin="0,0,8,0" TextChanged="Search_TextChanged"
                     ToolTip="Buscar no histórico" />
            <TextBlock Text="Histórico" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock x:Name="EmptyText" Style="{StaticResource Subtle}" Margin="0,0,0,8" />
        <ItemsControl x:Name="HistoryList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Row" Style="{StaticResource Card}" Background="{DynamicResource BrandCard}">
                        <Grid>
                            <!-- Hover: the row lights up and gets a Bordô mark on its edge, like a selection. -->
                            <Border x:Name="Light" Background="{DynamicResource BrandHover}" Margin="-15,-11" CornerRadius="3" Visibility="Collapsed" />
                            <Border x:Name="Mark" Background="{DynamicResource BrandAccent}" Width="2" Margin="-15,-11,0,-11"
                                    HorizontalAlignment="Left" Visibility="Collapsed" />
                            <DockPanel>
                                <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="16,0,0,0" Opacity="0">
                                    <Button Style="{StaticResource RowAction}" Content="&#xE8C8;" ToolTip="Copiar" Click="Copy_Click" />
                                    <Button Style="{StaticResource RowActionDestructive}" Content="&#xE74D;" ToolTip="Apagar"
                                            Click="Delete_Click" Margin="4,0,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding DateLabel}" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Light" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Actions" Property="Opacity" Value="1" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
