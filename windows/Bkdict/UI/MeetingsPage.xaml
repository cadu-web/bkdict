<UserControl x:Class="Bkdict.UI.MeetingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Recorded meetings: list on the left, summary and transcript of the selected one on the right (docs/reunioes.md). -->
    <StackPanel>
        <TextBlock Text="Reuniões" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource Subtle}"
                   Text="Grava o seu microfone e o áudio do computador, transcreve e resume. Tudo fica neste PC." />

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="RecordButton" Click="Record_Click" Padding="14,6" />
            <TextBlock x:Name="ElapsedText" FontFamily="{StaticResource MonoFont}" FontSize="14" VerticalAlignment="Center"
                       Margin="12,0,0,0" Foreground="{DynamicResource BrandAccent}" />
        </StackPanel>

        <TextBlock x:Name="EmptyText" Style="{StaticResource Subtle}" Margin="0,24,0,0"
                   Text="Nenhuma reunião gravada ainda. Comece uma aqui, pelo menu da bandeja ou pelo clique direito na barra de ditado." />

        <Grid x:Name="Body" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="MeetingList" Grid.Column="0" BorderThickness="0" Background="Transparent"
                     SelectionChanged="MeetingList_SelectionChanged" VerticalAlignment="Top">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Subtle}" FontSize="12" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding DurationLabel, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /><Run Text=" · " /><Run Text="{Binding StatusLabel, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="Detail" Grid.Column="1" Margin="24,0,0,0">
                <TextBlock x:Name="DetailTitle" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailMeta" Style="{StaticResource Subtle}" />

                <Border x:Name="MicOnlyBanner" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed"
                        Background="{DynamicResource BrandAccentTint}">
                    <TextBlock TextWrapping="Wrap"
                               Text="Só o seu microfone — libere a gravação do áudio do sistema para captar os outros." />
                </Border>

                <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="CopySummaryButton" Content="Copiar resumo" Click="CopySummary_Click" Margin="0,0,8,8" />
                    <Button x:Name="CopyTranscriptButton" Content="Copiar transcrição" Click="CopyTranscript_Click" Margin="0,0,8,8" />
                    <Button x:Name="ResummarizeButton" Content="Refazer resumo" Click="Resummarize_Click" Margin="0,0,8,8" />
                    <Button x:Name="DeleteButton" Content="Apagar" Click="Delete_Click" Margin="0,0,8,8" />
                </WrapPanel>

                <Border x:Name="DeleteConfirm" Style="{StaticResource Card}" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Apagar" Click="ConfirmDelete_Click" Margin="12,0,0,0" />
                            <Button Content="Cancelar" Click="CancelDelete_Click" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Apagar esta reunião? O áudio, a transcrição e o resumo saem deste PC." />
                    </DockPanel>
                </Border>

                <TextBlock Text="RESUMO" Style="{StaticResource Label}" Margin="0,18,0,6" />
                <StackPanel x:Name="SummaryPanel" />

                <TextBlock Text="TRANSCRIÇÃO" Style="{StaticResource Label}" Margin="0,22,0,6" />
                <StackPanel x:Name="TranscriptPanel" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
