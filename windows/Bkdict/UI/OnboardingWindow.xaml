<Window x:Class="Bkdict.UI.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bem-vindo ao BKDict"
        Width="720" Height="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrandBackground}"
        TextElement.FontFamily="{StaticResource BodyFont}"
        TextElement.Foreground="{DynamicResource BrandText}">
    <!-- First-launch setup, as on the Mac: one checklist, each item turning green when done. The rows are built in
         code (OnboardingWindow.xaml.cs). -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BrandBorder}" Padding="24,14">
            <DockPanel>
                <Button x:Name="FinishButton" DockPanel.Dock="Right" Click="Finish_Click" IsDefault="True" />
                <TextBlock x:Name="FooterText" Style="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <StackPanel Margin="40,36,40,0">
            <Image Source="pack://application:,,,/Assets/AppIcon.png" Width="72" Height="72" />
            <TextBlock Text="Bem-vindo ao BKDict" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Medium"
                       HorizontalAlignment="Center" Margin="0,10,0,0" />
            <TextBlock x:Name="Subtitle" Style="{StaticResource Subtle}" FontSize="14" TextAlignment="Center"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,24,0,0">
                <StackPanel x:Name="Items" />
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
